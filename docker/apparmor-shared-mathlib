# AppArmor profile for the worker container of compose.shared-mathlib.yaml.
#
# This is Docker's generated docker-default profile with one change: `deny mount,` is replaced by
# `mount,` and `pivot_root,`. bubblewrap needs both to build a shared Mathlib view, and it makes
# them inside a user namespace, where the kernel confines them to that namespace's own mounts.
# Every other docker-default rule is kept. Being confined by a profile at all is also what lets
# the container create a user namespace on hosts that restrict unconfined ones (Ubuntu 23.10 and
# later, kernel.apparmor_restrict_unprivileged_userns=1).
#
# Load it on the Docker host before starting the deployment, and again after a reboot unless it is
# installed under /etc/apparmor.d/ (see docs/docker.md):
#
#   sudo apparmor_parser --replace docker/apparmor-shared-mathlib

#include <tunables/global>

profile tauceti-shared-mathlib flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,

  # Host (privileged) processes and the container runtime may signal container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  # Container processes may signal one another.
  signal (send,receive) peer=tauceti-shared-mathlib,

  # No writes to files directly in /proc, or outside /proc/<pid>/ and /proc/sys/.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  # No writes under /proc/sys except /proc/sys/kernel/shm*.
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # No writes under /sys except /sys/fs/cgroup/.
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # `ps` inside the container.
  ptrace (trace,read,tracedby,readby) peer=tauceti-shared-mathlib,
}
