{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tauceti-github-state", "account_id": "ec2169bdf033f56b009956d4b64ba8ef",
  "main": "src/index.ts", "compatibility_date": "2026-10-11", "observability": {"enabled": true},
  "routes": [{"pattern": "github-state.taucetiproject.org", "custom_domain": true}],
  "keep_vars": true,
  "version_metadata": {"binding":"CF_VERSION"},
  "services": [{"binding":"BORS_ACTIVITY","service":"tauceti-bors"}],
  "durable_objects": {"bindings": [{"name": "REPOSITORIES", "class_name": "RepositoryState"}, {"name": "INSTALLATIONS", "class_name": "InstallationScheduler"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RepositoryState", "InstallationScheduler"]}],
  "r2_buckets": [{"binding": "ARCHIVE", "bucket_name": "tauceti-github-state"}],
  "queues": {"producers": [{"binding": "EVENTS", "queue": "tauceti-github-state-events"}], "consumers": [{"queue": "tauceti-github-state-events", "max_batch_size": 100, "max_batch_timeout": 1, "max_concurrency": 16, "max_retries": 20, "dead_letter_queue": "tauceti-github-state-events-dlq"}]},
  "triggers": {"crons": ["* * * * *"]},
  "env": {"test": {
    "name": "tauceti-github-state-test",
    "version_metadata": {"binding":"CF_VERSION"},
    "services": [{"binding":"BORS_ACTIVITY","service":"tauceti-bors"}],
    "vars": {"REFERENCE_READS": "true", "FAULT_INJECTION": "true", "MIGRATION_ENVIRONMENT": "test"},
    "routes": [{"pattern": "github-state-test.taucetiproject.org", "custom_domain": true}],
    "durable_objects": {"bindings": [{"name": "REPOSITORIES", "class_name": "RepositoryState"}, {"name": "INSTALLATIONS", "class_name": "InstallationScheduler"}]},
    "r2_buckets": [{"binding": "ARCHIVE", "bucket_name": "tauceti-github-state-test"}],
    "queues": {"producers": [{"binding": "EVENTS", "queue": "tauceti-github-state-test-events"}], "consumers": [{"queue": "tauceti-github-state-test-events", "max_batch_size": 100, "max_batch_timeout": 1, "max_concurrency": 16, "max_retries": 20, "dead_letter_queue": "tauceti-github-state-test-events-dlq"}]}
  }}
}
