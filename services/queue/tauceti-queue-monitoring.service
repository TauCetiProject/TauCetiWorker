# Tau Ceti queue public monitoring publisher (docs/queue/monitoring.md).
#
# Reads the queue's SQLite store read-only, builds the public snapshot and publishes it to the live-CI
# service. It cannot claim tasks, write statuses or land anything; its failure does not affect the
# controller or repair work. `services/queue/install-monitoring.sh` installs it. Host-specific
# extra arguments (e.g. retired workers' task roots) come from
# ~/.config/tauceti-queue/monitoring-environment (services/queue/monitoring-environment.example).
#
# WARNING: never add a systemd drop-in (*.service.d/*.conf) for this unit: drop-ins silently
# override what install-monitoring.sh installs, and the installer refuses to run while one exists.
# The installer renders this file with the code paths below pointing at the unit's own release
# directory, ~/TauCetiQueue-releases/<sha>-<time> (services/queue/release.sh). It runs origin/main
# HEAD; running any other revision requires explicit permission from a human operator and must be
# undone as soon as the change lands on main.

[Unit]
Description=Tau Ceti queue public monitoring publisher
Documentation=https://github.com/TauCetiProject/TauCetiWorker/blob/main/docs/queue/monitoring.md

[Service]
WorkingDirectory=%h/TauCetiQueue
EnvironmentFile=-%h/.config/tauceti-queue/monitoring-environment
Environment=PYTHONUNBUFFERED=1
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ExecStart=%h/TauCetiQueue/.venv/bin/python -m tauceti_queue.monitoring --database %h/TauCetiQueue-data/queue.sqlite3 --clone %h/TauCetiQueue-data/clone --worker-root %h/TauCetiQueue-data/repair --worker-root %h/TauCetiQueue-data/repair-2 --worker-root %h/TauCetiQueue-data/repair-3 $TAUCETI_QUEUE_MONITORING_ARGS --output %h/TauCetiQueue-data/monitoring/queue.json --state-file %h/TauCetiQueue-data/monitoring/publisher.json --publish-url https://ci-data.taucetiproject.org/ingest/operations/queue --token-file %h/TauCetiQueue-data/monitoring/token --follow --interval 5
Restart=on-failure
RestartSec=15
Nice=10
MemoryMax=512M
UMask=0077

[Install]
WantedBy=default.target
