# Observer of live repair phases for the public monitoring (docs/queue/monitoring.md).
# `services/queue/install-monitoring.sh` installs it.
#
# WARNING: never add a systemd drop-in (*.service.d/*.conf) for this unit: drop-ins silently override
# what install-monitoring.sh installs, and the installer refuses to run while one exists. It runs
# origin/main HEAD from ~/TauCetiQueue; running any other revision requires explicit permission from a
# human operator and must be undone as soon as the change lands on main.

[Unit]
Description=Observe live merge-queue repair phases

[Service]
WorkingDirectory=%h/TauCetiQueue
ExecStart=%h/TauCetiQueue/.venv/bin/python -m tauceti_queue.task_activity --root %h/TauCetiQueue-data/repair --root %h/TauCetiQueue-data/repair-2 --root %h/TauCetiQueue-data/repair-3 --follow
Restart=on-failure
RestartSec=5
Nice=10
UMask=0077

[Install]
WantedBy=default.target
