# Tau Ceti AI merge queue repair worker (docs/queue/operations.md, "Repair worker").
#
# A systemd user unit on a host with the Lean toolchain, `claude` and `gh`. It runs
# `python -m tauceti_queue.repair_task` from its release directory as a long-running worker:
# claim a repair or rebase-conflict task from the queue service, prepare warm artifacts, run the
# repair agent, push the chain to the task's submission ref and submit it; sleep when nothing is
# claimable. `services/queue/install-repair.sh` installs it and checks it is serving.
#
# Configuration is the environment file below (service URL, worker name, poll interval, the content
# clone, the task root and where the credentials are); secrets stay in files of mode 0600, never
# in this unit. Logs go to the journal: `journalctl --user -u tauceti-queue-repair -f`.
#
# WARNING: never add a systemd drop-in (*.service.d/*.conf) for this unit: drop-ins silently
# override what install-repair.sh installs, and the installers refuse to run while one exists. The
# installer renders this file with the code paths below pointing at the unit's own release
# directory, ~/TauCetiQueue-releases/<sha>-<time> (services/queue/release.sh). It runs origin/main
# HEAD; running any other revision requires explicit permission from a human operator and must be
# undone as soon as the change lands on main.

[Unit]
Description=Tau Ceti AI merge queue repair worker
Documentation=https://github.com/TauCetiProject/TauCetiWorker/blob/main/docs/queue/operations.md
After=network-online.target
Wants=network-online.target
# Memory pressure must remain a recoverable failure, even after repeated kills.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/TauCetiQueue
EnvironmentFile=%h/.config/tauceti-queue/repair-environment
Environment=PATH=%h/.local/bin:%h/.elan/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_SYNC=1
ExecStart=%h/TauCetiQueue/.venv/bin/python -m tauceti_queue.repair_task
# SIGTERM stops a running agent and keeps its claim and checkpoint; the restarted worker renews the
# claim and resumes the same session. A task past validation finishes its push and submission first.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=300
Restart=always
RestartSec=30
# Keep the user manager outside this worker's OOM victim group. Kill orphaned build/agent
# children together with the worker, then recover the task through the ordinary restart path.
OOMPolicy=kill
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tauceti-queue-repair
LimitNOFILE=65536
UMask=0077
# Repairs yield to CI and staging builds on the same host (tauceti-repair.slice). Every thread and
# child inherits the niceness and IO class from the exec, and the slice's weights cover any process
# in the unit's cgroup, including bwrap sandboxes and the agent's. Background publications join the
# slice too (tauceti_queue/repair_publish.py). Neither CPUWeight=idle nor the idle IO class: the
# claim lease, which renews from a thread of this process and touches the task root, must keep
# renewing under a full staging build, so the lowest best-effort IO priority instead.
Slice=tauceti-repair.slice
# The staging VM has first claim on the host's memory (decision 111): the kernel scores a process by
# its memory plus adjustment/1000 of the OOM domain's RAM and swap, so at 1000 a repair process outscores
# a VM at 200 unless that VM holds over 80% of it (139 GiB under tauchonki2's 112 GiB ceiling and
# 62 GiB swap, more than the ceiling). OOMPolicy=kill then restarts this worker.
OOMScoreAdjust=1000
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
