# Every ten minutes, run tauceti-queue-forgejo-team-sync.service (docs/forgejo-worker.md).

[Unit]
Description=Mirror Tau Ceti claim access to Forgejo every ten minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30
Unit=tauceti-queue-forgejo-team-sync.service

[Install]
WantedBy=timers.target
