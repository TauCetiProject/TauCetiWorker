# bash tests
RUN_SH=(docker_entrypoint.sh lifecycle.sh)
# Deliberate manual checks: egress needs the bubble sandbox/proxy; the cross-repo
# repair fixture needs Lean, Elixir and a bors checkout (see its module docstring).
# The source-read fixture starts a disposable Forgejo given FORGEJO_BINARY.
SKIP=(egress.sh integration_repair_fixture.py integration_forgejo_reads.py integration_forgejo_git.py integration_forgejo_source.py integration_forgejo_bootstrap.py integration_forgejo_native_launch.py)

# Modules whose storage fixtures compare inode/device identity and sweep real directories. They
# failed on Namespace runners' filesystem (#409) and run on GitHub's native ubuntu-24.04 image in
# CI; everything else is the `portable` group and runs anywhere.
NATIVE_FS=(cache_storage.py shared_mathlib.py verification_storage.py retention.py)
# Modules that read README.md, docs/*.md or workers.toml.example and assert on their contents. A
# change that touches only documentation can break these and nothing else, so CI runs just this
# group for it. The guard below keeps the list honest.
DOCS_CONTRACT=(pr_targeting.py review_throttles.py forge_contracts.py)

pass=0; fail=0; failed=()

summary() {
  echo "================================================================"
  echo "run-all: $pass passed, $fail failed (group: $GROUP, jobs: $JOBS)"
  ((${#failed[@]})) && printf '  failed: %s\n' "${failed[@]}"
  ((${#SKIP[@]}))   && printf '  skipped (requires external tooling): %s\n' "${SKIP[@]}"
}

# --- inventory guard: every tests/*.py and tests/*.sh must be classified --------------------------
# Catches a newly-added test that nobody wired in here: better a loud CI failure than a silent skip.
known=(" ${RUN_STDLIB[*]} ${RUN_SPECIAL[*]} ${RUN_SH[*]} ${SKIP[*]} ")
unclassified=()
for f in tests/*.py tests/*.sh; do
  base=$(basename "$f")
  [ "$base" = "run-all" ] && continue
  [[ "${known[*]}" == *" $base "* ]] || unclassified+=("$base")
done
if ((${#unclassified[@]})); then
  echo "ERROR: test file(s) not classified in tests/run-all (add to a RUN_* or SKIP list):" >&2
  printf '  - %s\n' "${unclassified[@]}" >&2
  exit 2
fi
for t in "${NATIVE_FS[@]}" "${DOCS_CONTRACT[@]}"; do
  [[ "${known[*]}" == *" $t "* ]] || { echo "ERROR: $t is in NATIVE_FS/DOCS_CONTRACT but not a known test" >&2; exit 2; }
done
# A test that asserts on the repository's documentation must be in DOCS_CONTRACT, or a docs-only
# change could break it without CI running it.
docs_contract=(" ${DOCS_CONTRACT[*]} ")
undeclared=()
for f in $(grep -lE 'REPO / "(README\.md|docs|workers\.toml\.example)"' tests/*.py); do
  base=$(basename "$f")
  [[ "${docs_contract[*]}" == *" $base "* ]] || undeclared+=("$base")
done
if ((${#undeclared[@]})); then
  echo "ERROR: test file(s) read README.md/docs/workers.toml.example but are not in DOCS_CONTRACT in tests/run-all:" >&2
  printf '  - %s\n' "${undeclared[@]}" >&2
  exit 2
fi

# --- select the group -----------------------------------------------------------------------------
in_list() { local needle="$1"; shift; [[ " $* " == *" $needle "* ]]; }
selected=()
for t in "${RUN_STDLIB[@]}" "${RUN_SPECIAL[@]}" "${RUN_SH[@]}"; do
  case "$GROUP" in
    all) selected+=("$t") ;;
    native) in_list "$t" "${NATIVE_FS[@]}" && selected+=("$t") ;;
    portable) in_list "$t" "${NATIVE_FS[@]}" || selected+=("$t") ;;
    docs) in_list "$t" "${DOCS_CONTRACT[@]}" && selected+=("$t") ;;
    *) echo "run-all: unknown group '$GROUP' (all|portable|native|docs)" >&2; exit 2 ;;
  esac
done

# --- resolve the interpreter once -----------------------------------------------------------------
# `uv run` syncs the environment on every call; resolving it once and running the modules with the
# environment's own interpreter saves that per-module cost and the lock contention between parallel
# modules. The environment's bin/ goes on PATH as `uv run` would arrange.
PY="$(uv run python -c 'import sys; print(sys.executable)')" || exit 1
VIRTUAL_ENV="$(dirname "$(dirname "$PY")")"
export PY VIRTUAL_ENV
export PATH="$VIRTUAL_ENV/bin:$PATH"

# run_one <module>: run one module in its own activity subtree, record its result and output.
# Prints one line per module as it finishes; the full output of failed modules is printed at the end
# so parallel modules never interleave. With --fail-fast, a failure stops new modules from starting
# (running ones finish). Exit status is the module's.
run_one() {
  local t="$1" d rc start end
  d="$RUN_ROOT/${t%.*}"
  mkdir -p "$d/activity"
  [ -e "$RUN_ROOT/stop" ] && exit 0
  export TAUCETI_ACTIVITY_DIR="$d/activity"
  export TAUCETI_FLEET_EVENTS="$d/activity/worker-events.jsonl"
  export TAUCETI_SHARED_MATHLIB_ROOT="$d/activity/mathlib-builds"
  export TAUCETI_BUILD_CACHE_ROOT="$d/activity/builds"
  export TAUCETI_REVIEW_MATHLIB_CACHE="$d/activity/review-sources"
  export TAUCETI_VERIFY_STORAGE_DIR="$d/activity/verification-storage"
  start=$SECONDS
  case "$t" in
    parity_selectors.py) "$PY" tests/parity_selectors.py tests/fixtures/pr_selectors.json >"$d/output" 2>&1 ;;
    *.sh) bash "tests/$t" >"$d/output" 2>&1 ;;
    *) "$PY" "tests/$t" >"$d/output" 2>&1 ;;
  esac
  rc=$?
  end=$SECONDS
  echo "$rc" >"$d/rc"
  if [ "$rc" -eq 0 ]; then
    echo "  [PASS] $t ($((end - start))s)"
  else
    echo "  [FAIL] $t (rc=$rc, $((end - start))s)"
    [ "$FAIL_FAST" = 1 ] && touch "$RUN_ROOT/stop"
  fi
  return "$rc"
}
export -f run_one
export RUN_ROOT FAIL_FAST

# --- run ------------------------------------------------------------------------------------------
echo "run-all: ${#selected[@]} modules, group $GROUP, $JOBS at a time, python $PY"
printf '%s\n' "${selected[@]}" | xargs -P "$JOBS" -I{} bash -c 'run_one "$1"' _ {}

for t in "${selected[@]}"; do
  d="$RUN_ROOT/${t%.*}"
  if [ ! -e "$d/rc" ]; then
    # Not started: --fail-fast stopped the run before this module.
    continue
  fi
  if [ "$(cat "$d/rc")" -eq 0 ]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1)); failed+=("$t")
    echo
    echo "== $t == (rc=$(cat "$d/rc"))"
    cat "$d/output"
  fi
done
echo
summary
[ "$fail" -eq 0 ]
