#!/usr/bin/env bash
# Run the whole test suite and report pass/fail. Exit 0 only if every test passes.
#
# The tests are standalone scripts (not pytest): each loads the `tauceti` program and exits 0/1.
# This runner knows how each one wants to be invoked, and which one to skip in a plain CI box:
#   - most are stdlib-only         -> the project interpreter
#   - parity_selectors needs a snapshot, not the network -> pass the bundled fixture as its arg
#   - dashboard uses the project's rich/textual/Tools dependencies -> the project interpreter
#   - docker_entrypoint/lifecycle are bash; lifecycle resolves its own python3
#   - egress needs the bubble sandbox/proxy              -> skipped here
# The Python version is taken from $UV_PYTHON when set (uv honours it), so CI can matrix over versions.
#
# Usage: tests/run-all [--fail-fast] [-j N] [--group all|portable|native|docs]
#   -j N      run up to N modules at once (default 1). Every module gets its own activity, fleet-event,
#             cache and verification-storage directories, so modules never share state, in any mode.
#   --group   which modules to run (default all):
#             native    the modules whose fixtures need a native filesystem (see NATIVE_FS)
#             portable  everything else; runs on any Linux box, including Namespace runners
#             docs      only the modules that assert on README.md, docs/*.md and workers.toml.example,
#                       which is all a documentation-only change can break (see DOCS_CONTRACT)
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# Unit fixtures use their mocked transport, never the public production mirror.
# Service tests explicitly override this; default-resolution tests remove it.
export TAUCETI_GITHUB_STATE_URL=""

FAIL_FAST=0
JOBS=1
GROUP=all
while [ $# -gt 0 ]; do
  case "$1" in
    --fail-fast) FAIL_FAST=1 ;;
    -j) JOBS="$2"; shift ;;
    -j*) JOBS="${1#-j}" ;;
    --group) GROUP="$2"; shift ;;
    --group=*) GROUP="${1#--group=}" ;;
    *) echo "usage: tests/run-all [--fail-fast] [-j N] [--group all|portable|native|docs]" >&2; exit 2 ;;
  esac
  shift
done
case "$JOBS" in ''|*[!0-9]*|0) echo "run-all: -j wants a positive integer, got '$JOBS'" >&2; exit 2 ;; esac

# Tests must keep receipts, usage history and legacy migration fixtures out of the operator's
# real activity store. Legacy containment markers are ignored by current workers.
# Each module gets its own subtree (see run_one), so concurrent modules cannot see each other's
# activity, fleet events, caches or verification storage.
RUN_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/tauceti-test-run-XXXXXX")"
trap 'rm -rf "$RUN_ROOT"' EXIT

