#!/usr/bin/env python3
"""Absolute installed/source wrapper; independent of shell startup PATH changes."""

import argparse
import sys
from pathlib import Path

# In a source checkout scripts/ sits beside the package; in a wheel it sits inside it.
location = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(location.parent if location.name == "tauceti_worker" else location))
from tauceti_worker.verification import add_parser, command  # noqa: E402

parser = argparse.ArgumentParser(prog=str(Path(__file__).resolve()))
sub = parser.add_subparsers(dest="command", required=True)
add_parser(sub)
raise SystemExit(command(parser.parse_args(["verify", *sys.argv[1:]])))
