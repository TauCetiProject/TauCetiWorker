#!/usr/bin/env python3
"""Shared local verification from the worker's pinned TauCetiTools installation."""

import sys

from tauceti_tools.templates import import_shared, run_script

if __name__ == "__main__":
    raise SystemExit(run_script("local_lint.py", sys.argv[1:]))
else:
    implementation = import_shared("local_lint.py", __name__)
    globals().update(vars(implementation))
    sys.modules[__name__] = implementation
