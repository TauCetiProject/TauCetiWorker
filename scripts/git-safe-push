#!/usr/bin/env bash
# git-safe-push — the ONLY sanctioned way to push a Tau Ceti PR branch.
#
# This is the [HARD] write arbiter (coordination contract §1): every PR-branch update goes through a
# branch-level compare-and-swap, so we NEVER silently overwrite another agent's work — cooperating or
# not — and we detect the race and bail. It does NOT depend on anyone honoring claims.
#
#   git push --force-with-lease=<ref>:<expected>  origin HEAD:<ref>
#     expected = <oid>  → succeeds iff the remote branch still equals the oid we observed at checkout
#     expected = ""     → create-only (succeeds iff the branch does not exist) — for authoring
#
# If a claim is in play, it is re-checked/renewed immediately before the push and the push FAILS CLOSED
# if the lease was lost (someone took over). The claim is [COOP] (avoids duplicate work); the branch CAS
# is what actually protects the write.
#
# Inputs (exported by the worker before it launches the agent; the agent just runs `git-safe-push [<branch>]`):
#   TAUCETI_PUSH_REF     destination branch on the head repo (or pass as $1)
#   TAUCETI_PUSH_EXPECT  observed remote head oid; empty/unset ⇒ create-only (new branch)
#   TAUCETI_PUSH_REMOTE  git remote or URL to push to (default: origin)
#   TAUCETI_CLAIM_KEY    optional claim key to verify/renew before pushing
#   TAUCETI_CLAIM_REPO   repository containing that claim (default: claim.sh's normal selection)
#   TAUCETI_CLAIM_SH     path to claim.sh (default: alongside this script)
set -uo pipefail

# 77 means permission refusal; 78 is stale-head rejection; 79 is server policy;
# 80 means local infrastructure failed before push.
# Other failures may have an uncertain remote outcome and must be reconciled.
[[ "${TAUCETI_RECOVERY_CONTINUATION:-}" != "1" ]] || { echo "git-safe-push: recovery supervisor must reverify and publish" >&2; exit 77; }

REF="${1:-${TAUCETI_PUSH_REF:-}}"
EXPECT="${TAUCETI_PUSH_EXPECT:-}"
REMOTE="${TAUCETI_PUSH_REMOTE:-origin}"
CLAIM_KEY="${TAUCETI_CLAIM_KEY:-}"
CLAIM_REPO_OVERRIDE="${TAUCETI_CLAIM_REPO:-}"
CLAIM_SH="${TAUCETI_CLAIM_SH:-$(cd "$(dirname "$0")" && pwd)/claim.sh}"

die() { echo "git-safe-push: $*" >&2; exit 77; }
infra_die() {
    # Only remove this invocation's never-sent intent, preserving any older
    # uncertain push. A failed cleanup remains conservatively recoverable.
    if [[ -n "${PENDING:-}" && -n "${ATTEMPT:-}" ]]; then
        git update-ref -d "$PENDING" "$ATTEMPT" 2>/dev/null || true
    fi
    echo "git-safe-push: $*" >&2; exit 80
}
claim() {
    if [[ -n "$CLAIM_REPO_OVERRIDE" ]]; then
        CLAIM_REPO="$CLAIM_REPO_OVERRIDE" "$CLAIM_SH" "$@"
    else
        "$CLAIM_SH" "$@"
    fi
}
[[ -n "$REF" ]] || die "no destination branch (set TAUCETI_PUSH_REF or pass it as an argument)"

# 1) Lease check (fail closed if we no longer hold the claim someone may have taken over).
if [[ -n "$CLAIM_KEY" && -x "$CLAIM_SH" ]]; then
    if ! claim holds "$CLAIM_KEY"; then
        claim renew "$CLAIM_KEY" >/dev/null 2>&1 \
            || die "lease '$CLAIM_KEY' lost (another agent took over) — refusing to push"
    fi
fi

# 2) Branch-level CAS push. expected="" ⇒ create-only; else must still equal the observed oid.
# Resolve HEAD once: the oid pushed is the oid later recorded as published, even if HEAD moves.
OID="$(git rev-parse --verify "${TAUCETI_PUSH_OID:-HEAD}^{commit}")" || infra_die "publication does not name a commit"
DEST="$REF"
[[ "$DEST" == refs/* ]] || DEST="refs/heads/$REF"
echo "git-safe-push: $REMOTE ${OID:0:12}:$REF (--force-with-lease=$REF:${EXPECT:-<create-only>})" >&2
PUSH_STATUS="$(mktemp)" || infra_die "cannot record push status"
trap 'rm -f "$PUSH_STATUS"' EXIT
# An annotated tag retains the exact source and a distinct invocation identity
# without synthetic source commits that would obstruct ordinary checkout cleanup.
SCOPE="${TAUCETI_PUSH_SCOPE:-unscoped}"
ATTEMPT="$(printf 'object %s\ntype commit\ntag tauceti-push-attempt\ntagger tauceti-worker <tauceti-worker@localhost> 0 +0000\n\n%s\n%s\n%s\n' "$OID" "$OID" "$EXPECT" "$PUSH_STATUS" | git mktag)" || infra_die "cannot record push attempt"
PENDING="refs/tauceti/pending-push/$SCOPE/${REF#refs/heads/}"
ATTEMPT_REF="refs/tauceti/push-attempt-scope/$SCOPE/${REF#refs/heads/}"
REJECTED_REF="refs/tauceti/push-rejected-scope/$SCOPE/${REF#refs/heads/}"
# Keep the earliest unacknowledged attempt across subsequent attempts. A later
# rejection cannot prove that an earlier transport failure was never accepted.
if ! git rev-parse --verify "$PENDING" >/dev/null 2>&1; then
    git update-ref "$PENDING" "$ATTEMPT" "" || infra_die "cannot retain pending publication"
fi
git update-ref "$ATTEMPT_REF" "$ATTEMPT" || infra_die "cannot retain push attempt"
if git -c push.followTags=false push --porcelain --force-with-lease="$REF:$EXPECT" "$REMOTE" "$OID:$DEST" >"$PUSH_STATUS"; then
    cat "$PUSH_STATUS"
    CHANGED=0
    while IFS=$'\t' read -r flag destination _summary; do
        if [[ "$destination" == "$OID:$DEST" ]]; then
            case "$flag" in ' '|+|'*') CHANGED=1 ;; esac
        fi
    done <"$PUSH_STATUS"
    # Local publication evidence: checkout preparation treats commits reachable from
    # refs/tauceti/published/* as published, so pushed work is not mistaken for unfinished source.
    if { [[ "$CHANGED" == 0 ]] || git update-ref "refs/tauceti/published/scope/$SCOPE/${REF#refs/heads/}" "$OID" 2>/dev/null; } &&
       git update-ref "refs/tauceti/published/push/${REF#refs/heads/}" "$OID" 2>/dev/null; then
        git update-ref -d "$PENDING" 2>/dev/null || true
    fi
    if [[ "$CHANGED" == 1 && -n "${TAUCETI_FLEET_EVENTS:-}" && -n "${TAUCETI_FLEET_PYTHON:-}" && -n "${TAUCETI_FLEET_EMITTER:-}" ]]; then
        "$TAUCETI_FLEET_PYTHON" -I "$TAUCETI_FLEET_EMITTER" pushed 2>/dev/null || true
    fi
    exit 0
fi
cat "$PUSH_STATUS"
while IFS=$'\t' read -r flag destination summary; do
    if [[ "$flag" == '!' && "$destination" == "$OID:$DEST" ]]; then
        case "$summary" in
            '[rejected]'*)
                git update-ref "$REJECTED_REF" "$ATTEMPT" 2>/dev/null || true
                git update-ref -d "$PENDING" "$ATTEMPT" 2>/dev/null || true
                echo "git-safe-push: stale destination; re-integrate before another CAS push" >&2; exit 78 ;;
            '[remote rejected]'*)
                git update-ref "$REJECTED_REF" "$ATTEMPT" 2>/dev/null || true
                git update-ref -d "$PENDING" "$ATTEMPT" 2>/dev/null || true
                echo "git-safe-push: server policy rejected this push" >&2; exit 79 ;;
        esac
    fi
done <"$PUSH_STATUS"
echo "git-safe-push: push failed with an uncertain remote outcome; reconcile before replay" >&2
exit 1
